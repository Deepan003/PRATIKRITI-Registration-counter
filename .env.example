# Copy to .env.local for `vercel dev` (never commit it). In production, set these in
# Vercel → Project → Settings → Environment Variables.

# Password people type to open the dashboard.
DASHBOARD_PASSWORD=

# Optional: any long random string. Changing it (or the password) signs everyone out.
SESSION_SECRET=

# Paste the whole service-account JSON key file contents (one line is fine):
GOOGLE_SERVICE_ACCOUNT_JSON=

# The four response sheets: the sheet ID or the full sheet URL both work.
SHEET_CHITRANTAR=
SHEET_KSHANIKA=
SHEET_CHITRAGATI=
SHEET_RONGOLIPI=
